# Shared household password (required when the app is on the internet)
APP_PASSWORD=pick-something-long
# Optional: lets Claude read PDFs, photos of recipe cards and messy files
ANTHROPIC_API_KEY=
# Optional: Dropbox app key (you can also paste it into the app instead)
DROPBOX_APP_KEY=
# Optional: where the database lives (default ./data/mealplanner.db)
# DB_PATH=/data/mealplanner.db
