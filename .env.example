# Sign-up: the first person on a fresh server creates their family; everyone else joins by invite link.
# Optional: let other households start their own family on this server too
# ALLOW_NEW_FAMILIES=true
# ...or only those who know a code:
# FAMILY_SIGNUP_CODE=some-code
# Optional: lets Claude read PDFs, photos of recipe cards and messy files
ANTHROPIC_API_KEY=
# Optional: default Dropbox app key (families can also paste their own in the app)
DROPBOX_APP_KEY=
# Optional: where the database lives (default ./data/mealplanner.db)
# DB_PATH=/data/mealplanner.db
# Optional: fixed secret for signing login cookies (otherwise generated and stored in the database)
# SESSION_SECRET=
