{
  "name": "mealplanner",
  "version": "1.0.0",
  "private": true,
  "description": "Shared household meal planner: recipes, weekly plan, smart shopping list.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "import": "node --disable-warning=ExperimentalWarning scripts/import-folder.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "icons": "node scripts/icons.cjs",
    "reset-password": "node --disable-warning=ExperimentalWarning scripts/reset-password.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "express": "^5.3.0",
    "mammoth": "^1.13.0"
  }
}
