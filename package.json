{
  "name": "mealplanner",
  "version": "1.0.0",
  "private": true,
  "description": "Shared family meal planner on Cloudflare Workers: recipes, weekly plan, smart shopping list.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy && wrangler d1 migrations apply mealplanner --remote",
    "db:migrate": "wrangler d1 migrations apply mealplanner --remote",
    "db:migrate:local": "wrangler d1 migrations apply mealplanner --local",
    "seed": "node scripts/seed.js",
    "test": "node --test test/*.test.js",
    "icons": "node scripts/icons.cjs",
    "vendor": "node scripts/vendor.js"
  },
  "dependencies": {
    "hono": "^4.13.18"
  },
  "devDependencies": {
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "wrangler": "^4.162.0"
  }
}
