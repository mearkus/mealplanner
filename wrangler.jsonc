{
  // Cloudflare Workers config. See README → "Deploy to Cloudflare".
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mealplanner",
  "main": "worker/index.js",
  "workers_dev": true,
  "compatibility_date": "2026-11-01",
  "build": { "command": "node scripts/vendor.js" },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      // No database_id: the first deploy creates the D1 database automatically and later deploys reuse it.
      "database_name": "mealplanner",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "FAMILY_ROOM", "class_name": "FamilyRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FamilyRoom"] }],
  // Keep variables set in the Cloudflare dashboard (e.g. GOOGLE_CLIENT_ID) when deploying.
  "keep_vars": true,
  "vars": {
    // "true" lets anyone with a Google account start a new family (otherwise: first family + invites only).
    "ALLOW_NEW_FAMILIES": "false"
  }
  // Set in the dashboard (Settings → Variables and Secrets): GOOGLE_CLIENT_ID.
  // Optional secret: SESSION_SECRET (otherwise one is generated and stored in D1 on first use).
}
